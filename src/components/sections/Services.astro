---
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Grid from '@components/ui/Grid.astro';
import Card from '@components/ui/Card.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Service {
  title: string;
  description: string;
  href?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  services: Service[];
}

const {
  eyebrow,
  title,
  description,
  services,
} = Astro.props;
---

<Section background="muted">
  <div class="services">
    <SectionHeading
      eyebrow={eyebrow}
      title={title}
      description={description}
      align="center"
    />

    <Grid columns={2} gap="lg">
      {services.map((service) => (
        <Card
          title={service.title}
          description={service.description}
          href={service.href}
        >
          {service.image && (
            <Image slot="image" src={service.image} alt={service.imageAlt ?? ""} width={800} height={600} loading="lazy" />
          )}
        </Card>
      ))}
    </Grid>
  </div>
</Section>
