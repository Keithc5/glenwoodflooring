---
import BaseLayout from "@layouts/BaseLayout.astro";
import { business } from "@config/activeSite";
import Hero from "@components/sections/Hero.astro";
import Services from "@components/sections/Services.astro";
import Gallery from "@components/sections/Gallery.astro";
import ContactCTA from "@components/sections/ContactCTA.astro";
import Section from "@components/ui/Section.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import Grid from "@components/ui/Grid.astro";
import Card from "@components/ui/Card.astro";
import { Image } from "astro:assets";
import homeHeroImage from "../assets/images/home/herringbone.jpg";
import homeFloorImage from "../assets/images/services/home-floor-1.jpg";
import beforeProjectImage from "../assets/images/services/before-1.jpg";
import afterProjectImage from "../assets/images/services/after-1.jpg";
import specialistBeforeImage from "../assets/images/services/specialist-before-1.jpg";
import specialistAfterImage from "../assets/images/services/specialist-after-1.jpg";

const homepageServices = business.services.map((service) =>
  service.title === "Floor Sanding"
    ? { ...service, image: homeFloorImage }
    : service,
);

const projectPreviewItems = [
  { title: "Before floor restoration", image: beforeProjectImage, alt: "Timber floor before restoration" },
  { title: "After floor restoration", image: afterProjectImage, alt: "Timber floor after restoration" },
  { title: "Before specialist floor restoration", image: specialistBeforeImage, alt: "Specialist timber floor before restoration" },
  { title: "After specialist floor restoration", image: specialistAfterImage, alt: "Specialist timber floor after restoration" },
];
---
<BaseLayout title={business.seo.title} description={business.seo.description}>
  <Hero variant="immersive" eyebrow="Timber flooring services" title="Restore the natural character of your timber floor" description="Professional timber floor sanding, staining, finishing, restoration and specialist flooring services in Ireland." primaryCtaLabel="Discuss your floor" primaryCtaHref="/contact" secondaryCtaLabel="Explore our work" secondaryCtaHref="/our-work">
    <Image slot="image" src={homeHeroImage} alt="Restored herringbone timber floor" width={800} height={600} />
  </Hero>
  <Section><SectionHeading eyebrow="Glenwood Flooring" title="Professional timber floor care" description="Based in Glenamaddy, County Galway, Glenwood Flooring provides renovation and restoration services for timber floors in homes and businesses throughout Ireland." align="center" /></Section>
  <Services eyebrow="Services" title="Timber flooring services" description="Practical services for restoring, changing and protecting timber floors." services={homepageServices} />
  <Section><SectionHeading eyebrow="Why choose Glenwood" title="Flooring work planned around the floor" description="From initial assessment through sanding and finishing, the work is shaped around the timber, its condition and how the space is used." align="center" /><Grid columns={3} gap="md"><Card title="Restoration focused" description="Repairs and preparation address worn or damaged areas before finishing." /><Card title="Domestic and commercial" description="Services are available for homes, businesses and large community spaces." /><Card title="Specialist capability" description="Sports, gym and dance floors can receive the treatment their scale and use require." /></Grid></Section>
  <Gallery eyebrow="Our work" title="See the difference" description="See how Glenwood brings tired and worn timber floors back to life through professional sanding and restoration." items={projectPreviewItems} columns={2} />
  <ContactCTA {...business.contactCta} />
</BaseLayout>
<style>:global(.hero__image img){width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:var(--radius-lg)}</style>
