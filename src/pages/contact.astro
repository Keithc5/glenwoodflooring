---
import BaseLayout from '@layouts/BaseLayout.astro';
import { business } from '@config/activeSite';
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Grid from '@components/ui/Grid.astro';
import Card from '@components/ui/Card.astro';
import Button from '@components/ui/Button.astro';
import SocialLinks from '@components/ui/SocialLinks.astro';

const contactCards = [
  {
    title: "Phone",
    description: business.contact.phone,
    href: `tel:${business.contact.phone.replaceAll(" ", "")}`,
  },
  {
    title: "Location",
    description: business.contact.address,
  },
];
---

<BaseLayout
  title={`Contact Glenwood Flooring | Floor Restoration Galway`}
  description="Contact Glenwood Flooring in County Galway for timber floor sanding, restoration, staining, finishing and a project quote."
>
    <Section>
      <div class="contact-page__intro">
        <SectionHeading
          eyebrow={business.contactPage.eyebrow}
          title={business.contactPage.title}
          description={business.contactPage.description}
          align="center"
          headingLevel="h1"
        />
      </div>
    </Section>

    <Section background="muted">
      <div class="contact-page__details">
        <SectionHeading
          title={business.contactPage.detailsTitle}
          description={business.contactPage.detailsDescription}
          align="center"
        />

        <Grid columns={2} gap="md">
          {contactCards.map((item) => (
            <Card
              title={item.title}
              description={item.description}
              href={item.href}
            />
          ))}
        </Grid>
      </div>
    </Section>

    <Section background="muted">
      <div class="contact-page__cta">
        <SectionHeading
          title="Get in touch"
          description="For timber floor restoration, availability or to arrange a quote, speak directly with Glenwood Flooring."
          align="center"
        />

        <div class="contact-page__callout">
          <Button href={`tel:${business.contact.phone.replaceAll(" ", "")}`} size="lg">
            Call {business.contact.phone}
          </Button>
          <SocialLinks />
        </div>
      </div>
    </Section>

</BaseLayout>
